# Choose azure_openai or azure_speech
TTS_PROVIDER=azure_openai

# Azure OpenAI TTS Configuration
# A resource base URL or a full /audio/speech URL is accepted.
AZURE_TTS_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_API_KEY=your-tts-api-key-here
AZURE_TTS_MODEL=your-gpt-4o-mini-tts-deployment-name

# Azure AI Speech Configuration (used when TTS_PROVIDER=azure_speech)
AZURE_SPEECH_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_SPEECH_KEY=your-speech-resource-api-key
AZURE_SPEECH_VOICE=tr-TR-Elif:MAI-Voice-2-Flash

# Azure OpenAI LLM Configuration (for Podcast Transformation)
# This is the base endpoint (without /openai/deployments/...)
AZURE_LLM_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_LLM_API_KEY=your-llm-api-key-here
AZURE_LLM_DEPLOYMENT=gpt-4.1

# Note: You can use the same API key for both TTS and LLM if they're in the same resource
# The LLM endpoint should be just the base URL (e.g., https://your-resource.openai.azure.com)
# Model values are Azure deployment names and can also be changed in the UI.
