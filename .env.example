# Azure OpenAI TTS Configuration
# This is the endpoint for your deployed TTS model
AZURE_TTS_ENDPOINT=https://your-resource-name.openai.azure.com/openai/deployments/your-tts-deployment-name/audio/speech?api-version=2024-10-21
AZURE_API_KEY=your-tts-api-key-here

# Azure OpenAI LLM Configuration (for Podcast Transformation)
# This is the base endpoint (without /openai/deployments/...)
AZURE_LLM_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_LLM_API_KEY=your-llm-api-key-here

# Note: You can use the same API key for both TTS and LLM if they're in the same resource
# The LLM endpoint should be just the base URL (e.g., https://your-resource.openai.azure.com)
# The model name (gpt-4o-mini, gpt-4o, etc.) is selected in the UI and should match your deployment name
